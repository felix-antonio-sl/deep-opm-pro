# Reglas de Codex para implementar opforja rehecho (docs/rehacer/plan/).
#
# En el sandbox workspace-write, .git y .codex son de solo lectura: sin estas reglas
# cada commit pediría aprobación y un /goal largo se detendría. Se cargan solo si el
# proyecto es de confianza. WP-19 las retira junto con docs/rehacer/.

# Git local: preparar, confirmar y mover archivos versionados.
prefix_rule(
    pattern = ["git", ["add", "commit", "mv", "rm", "restore", "switch", "fetch", "pull"]],
    decision = "allow",
    justification = "Git local en el checkout de trabajo del plan",
    match = [
        "git add -A",
        "git commit -m 'feat(nucleo): matriz de validez única (WP-2)'",
        "git mv fixtures/demo-models/a.json app/fixtures/v0/a.json",
        "git pull --ff-only origin rehacer",
    ],
)

# Tag base del plan, nada más.
prefix_rule(
    pattern = ["git", "tag", "pre-rehacer"],
    decision = "allow",
    justification = "Marcar la base del plan",
)

# Push solo a la rama de trabajo y al tag base.
prefix_rule(
    pattern = ["git", "push", "origin", ["rehacer", "pre-rehacer"]],
    decision = "allow",
    justification = "Publicar cada paquete cerrado en origin/rehacer",
    match = ["git push origin rehacer", "git push origin pre-rehacer"],
    not_match = ["git push origin main", "git push origin rehacer:main"],
)
prefix_rule(
    pattern = ["git", "push", "-u", "origin", "rehacer"],
    decision = "allow",
    justification = "Primer push de la rama de trabajo",
)

# Prohibido en esta implementación: merge a main, reescritura forzada y despliegue.
prefix_rule(
    pattern = ["git", "push", "origin", ["main", "HEAD:main", "rehacer:main"]],
    decision = "forbidden",
    justification = "Solo el dueño integra en main; WP-19 abre un PR",
)
prefix_rule(
    pattern = ["git", "push", "-u", "origin", "main"],
    decision = "forbidden",
    justification = "Solo el dueño integra en main; WP-19 abre un PR",
)
prefix_rule(
    pattern = ["git", "push", ["-f", "--force", "--force-with-lease", "--mirror", "--delete"]],
    decision = "forbidden",
    justification = "Ningún push reescribe ni borra historia remota",
)
prefix_rule(
    pattern = ["git", "push", "origin", "rehacer", ["-f", "--force", "--force-with-lease", "main"]],
    decision = "forbidden",
    justification = "Ningún push reescribe historia ni toca main",
)
prefix_rule(
    pattern = [["docker", "docker-compose", "./deploy/deploy.sh", "deploy/deploy.sh"]],
    decision = "forbidden",
    justification = "Sin contenedores ni despliegue: el plan no lo autoriza",
)
